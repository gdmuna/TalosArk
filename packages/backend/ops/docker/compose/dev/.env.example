# Docker Compose automatically reads .env for Compose interpolation.
# It is not mounted into Casdoor. Casdoor's database settings live in
# casdoor/app.conf instead.

VALKEY_IMAGE=valkey/valkey:9.1-trixie
CASDOOR_IMAGE=casbin/casdoor:4.3.0

VALKEY_PORT=6379
CASDOOR_PORT=8000

# This is the current Docker network of dev-infra-postgres.
POSTGRES_NETWORK=dev-infra_default
