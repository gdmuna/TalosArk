# Docker Compose automatically reads .env for Compose interpolation.
# It is not mounted into any container. Copy this file to .env before starting.

POSTGRES_IMAGE=postgres:18.6-trixie
VALKEY_IMAGE=valkey/valkey:9.1-trixie
RUSTFS_IMAGE=rustfs/rustfs:latest
CASDOOR_IMAGE=casbin/casdoor:4.3.0

POSTGRES_USER=admin
# Use only URI-safe characters: A-Z, a-z, 0-9, ., _, ~, and -.
# The value is embedded in the backend URL.
POSTGRES_PASSWORD=admin
POSTGRES_DB=talosark
POSTGRES_SHADOW_DB=talosark_shadow
CASDOOR_DB=casdoor
POSTGRES_PORT=5432

# RustFS access keys must not contain '/'.
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

NODE_ENV=production
BACKEND_PORT=3000
CASDOOR_PORT=8000
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

S3_REGION=us-east-1
S3_BUCKET_PUBLIC=talos-ark-public
S3_BUCKET_PRIVATE=talos-ark-private
S3_BUCKET_STAGING=talos-ark-staging
S3_PUBLIC_BASE_URL=http://localhost:9000
