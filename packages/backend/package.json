    "build": "tsx tooling/cli/entry.ts build",
    "typecheck": "tsx tooling/cli/entry.ts check",
    "test": "tsx tooling/cli/entry.ts test",
    "lint": "eslint",
    "prisma": "tsx tooling/cli/entry.ts prisma",
    "dotenvx": "dotenvx",
    "db:gen-client": "tsx tooling/cli/entry.ts prisma generate",
    "db:studio": "tsx tooling/cli/entry.ts prisma studio -b none",
    "db:pull": "tsx tooling/cli/entry.ts prisma db pull",
    "db:push": "tsx tooling/cli/entry.ts prisma db push",
    "db:init": "tsx tooling/cli/entry.ts db init",
    "db:prepare": "tsx tooling/cli/entry.ts db init",
    "db:seed": "tsx tooling/cli/entry.ts seed",
    "db:seed:build": "tsx tooling/cli/entry.ts build --target seed",
    "seed:typecheck": "tsx tooling/cli/entry.ts check --scope seed",
    "db:apply-ddl": "tsx tooling/cli/entry.ts db ddl apply --only storage-node",
    "db:apply-identity-ddl": "tsx tooling/cli/entry.ts db ddl apply --only identity",
    "db:apply-inventory-ddl": "tsx tooling/cli/entry.ts db ddl apply --only inventory",
    "db:apply-approval-ddl": "tsx tooling/cli/entry.ts db ddl apply --only approval",
    "auth:provision": "tsx tooling/cli/entry.ts account provision",
    "auth:super-admin": "tsx tooling/cli/entry.ts account super-admin",
    "storage:check": "tsx tooling/cli/entry.ts storage check",
    "storage:init": "tsx tooling/cli/entry.ts storage init",
    "worker:local": "tsx tooling/cli/entry.ts app worker --env dev.local",
    "worker:prod": "tsx tooling/cli/entry.ts app worker --env prod",
    "tool:build": "tsx tooling/cli/entry.ts build --target ops",
    "start:local": "tsx tooling/cli/entry.ts app dev --env dev.local",
    "start:dev": "tsx tooling/cli/entry.ts app dev --env dev",
    "start:prod": "tsx tooling/cli/entry.ts app run --env prod",
    "test:local": "tsx tooling/cli/entry.ts test --env test.local",
    "test:coverage": "tsx tooling/cli/entry.ts test --env test --coverage",
    "test:watch": "tsx tooling/cli/entry.ts test --env test --watch",
    "lint:fix": "eslint --fix",
    "env:encrypt": "tsx tooling/cli/entry.ts env encrypt",
    "env:decrypt": "tsx tooling/cli/entry.ts env decrypt",
    "docs:gen-openapi": "tsx tooling/cli/entry.ts openapi export"
  },
