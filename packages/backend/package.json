  "scripts": {
    "tool": "tsx tooling/cli/entry.ts",
    "dev": "tsx tooling/cli/entry.ts app dev",
    "start": "node dist/src/main.js",
    "worker": "node dist/src/worker.js",
    "db": "tsx tooling/cli/entry.ts db",
    "seed": "tsx tooling/cli/entry.ts seed",
    "storage": "tsx tooling/cli/entry.ts storage",
    "account": "tsx tooling/cli/entry.ts account",
