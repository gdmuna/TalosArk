{
  "name": "@talos-ark/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "author": "Maiturin",
  "description": "璇玑云库 - 后端服务",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "db:gen-client": "pnpm prisma generate",
    "db:studio": "pnpm prisma studio -b none",
    "db:pull": "pnpm prisma db pull",
    "db:push": "pnpm prisma db push",
    "build": "nest build && tsc-alias -v",
    "start:local": "dotenvx run -f secrets/env/.env.development.local -f secrets/env/.env.development -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main.js\"",
    "start:dev": "dotenvx run -f secrets/env/.env.development -- nest start --watch --exec \"pnpm tsc-alias -v && node dist/src/main.js\"",
    "start:prod": "pnpm build && dotenvx run -f secrets/env/.env.production -- node dist/src/main.js",
    "test": "dotenvx run -f secrets/env/.env.test -- vitest run",
    "test:local": "dotenvx run -f secrets/env/.env.test.local -f secrets/env/.env.test -- vitest run",
    "test:coverage": "dotenvx run -f secrets/env/.env.test -- vitest run --coverage",
    "test:watch": "dotenvx run -f secrets/env/.env.test -- vitest",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "env:encrypt": "dotenvx encrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "env:decrypt": "dotenvx decrypt -f secrets/env/.env.development secrets/env/.env.test secrets/env/.env.production",
    "docs:gen-openapi": "dotenvx run -f secrets/env/.env.development -- tsx scripts/generate-openapi.ts",
    "docs:dev": "dotenvx run -f secrets/env/.env.development -- pnpm --filter @talos-ark/docsite dev",
    "docs:build": "pnpm --filter @talos-ark/docsite build",
    "docs:serve": "pnpm --filter @talos-ark/docsite serve",
    "prisma": "tsx scripts/prisma.ts",
    "dotenvx": "dotenvx"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/lib-storage": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@dotenvx/dotenvx-ops": "^0.56.1",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@keyv/valkey": "^1.0.11",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/nestjs-api-reference": "^1.2.18",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cache-manager": "^7.2.9",
    "casdoor-nodejs-sdk": "^1.34.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "fastify": "5.11.3",
    "figlet": "^1.11.4",
    "gradient-string": "^3.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.3",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
