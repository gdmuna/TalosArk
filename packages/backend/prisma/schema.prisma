generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(ulid())
  username     String   @unique
  email        String   @unique
  passwordHash String?
  nickname     String?
  realname     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile        UserProfile?
  statusHistory  UserStatusHistory[]
  ownedOrgs      Organization[]      @relation("OrgOwner")
  orgMemberships OrganizationUser[]
  nodeLogs       NodeLog[]
  reagentLogs    ReagentLog[]
  feedbacks      Feedback[]
  files          File[]
  externalIdentities ExternalIdentity[]
  sessions           Session[]

  @@index(createdAt)
}

/// 一次 OIDC 授权流程的短期服务端状态。
/// state 仅以哈希形式持久化；verifier 在完成回调后立即标记为已消费。
model LoginTransaction {
  id           String   @id @default(ulid())
  stateHash    String   @unique
  nonce        String
  pkceVerifier String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

/// 外部 OIDC 主体与 TalosArk 本地用户之间的稳定绑定。
model ExternalIdentity {
  id        String   @id @default(ulid())
  issuer    String
  subject   String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
}

/// TalosArk 自有的可撤销刷新会话；Access Token 仍保持短生命周期无状态 JWT。
model Session {
  id              String   @id @default(ulid())
  userId          String
  refreshTokenJti String   @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserProfile {
  userId     String          @id @default(uuid(7))
  nickname   String?
  avatarId   String?
  bio        String?
  sex        UserProfileSex?
  sexVisible Boolean         @default(true)
  birthday   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user   User  @relation(fields: [userId], references: [id])
  avatar File? @relation(fields: [avatarId], references: [id])
}

enum UserProfileSex {
  MALE
  FEMALE
  OTHER // wtf???
}

model UserStatusHistory {
  id           String                 @id @default(uuid(7))
  userId       String
  operatorType UserStatusOperatorType
  operatorId   String?
  fromStatus   UserStatus
  toStatus     UserStatus
  remark       String?
  createdAt    DateTime               @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserStatusOperatorType {
  SYSTEM
  MANUAL
}

model Organization {
  id          String   @id @default(ulid())
  name        String
  description String?
  ownerId     String
  isPublic    Boolean  @default(false)
  avatarUrl   String?
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User               @relation("OrgOwner", fields: [ownerId], references: [id])
  members        OrganizationUser[]
  nodes          Node[]
  ownedShares    ResourceShare[]    @relation("OwnedShares")
  receivedShares ResourceShare[]    @relation("ReceivedShares")
  reagents       Reagent[]
  reagentTypes   ReagentType[]

  @@index([ownerId])
}

model OrganizationUser {
  id        String        @id @default(ulid())
  orgId     String
  userId    String
  role      OrgRole       @default(MEMBER)
  status    OrgUserStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrgUserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum NodeType {
  ROOT
  CONTAINER
  BOX
  BOX_SLOT
}

model Node {
  id          String   @id @default(ulid())
  orgId       String
  parentId    String?
  name        String
  description String?
  type        NodeType
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent     Node?           @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Node[]          @relation("NodeTree")
  // aliases    NodeAlias[]
  images     NodeImage[]
  NodeLogs   NodeLog[]
  gridConfig NodeGridConfig?
  reagents   Reagent[]

  @@index([orgId])
  @@index([parentId])
  @@index([orgId, parentId])
}

