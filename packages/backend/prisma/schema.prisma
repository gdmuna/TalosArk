generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  username     String   @unique
  email        String   @unique
  passwordHash String?
  // nickname     String?
  // realname     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            UserProfile?
  externalIdentities ExternalIdentity[]
  sessions           Session[]

  @@index(createdAt)
}

model UserProfile {
  userId     String          @id @db.Uuid
  nickname   String?
  avatarId   String?
  bio        String?
  sex        UserProfileSex?
  sexVisible Boolean         @default(true)
  birthday   DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum UserProfileSex {
  MALE
  FEMALE
  OTHER // wtf???
}

/// 外部 OIDC 主体与 TalosArk 本地用户之间的稳定绑定。
model ExternalIdentity {
  id        String   @id @default(uuid(7)) @db.Uuid
  issuer    String
  subject   String
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject])
  @@index([userId])
}

