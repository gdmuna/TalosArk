//   @@index([nodeId])
// }

model NodeImage {
  id        String   @id @default(ulid())
  nodeId    String
  imageUrl  String
  createdAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

model NodeLog {
  id            String   @id @default(ulid())
  nodeId        String
  userId        String
  operationType String
  detail        String?
  createdAt     DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([nodeId])
  @@index([userId])
}

enum ShareResourceType {
  NODE
}

enum SharePermission {
  READ
  WRITE
}

enum ShareStatus {
  PENDING
  ACTIVE
  REVOKED
}

model ResourceShare {
  id           String            @id @default(ulid())
  resourceType ShareResourceType
  resourceId   String
  ownerOrgId   String
  granteeOrgId String
  permission   SharePermission   @default(READ)
  status       ShareStatus       @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  ownerOrg   Organization @relation("OwnedShares", fields: [ownerOrgId], references: [id])
  granteeOrg Organization @relation("ReceivedShares", fields: [granteeOrgId], references: [id])

  @@index([ownerOrgId])
  @@index([granteeOrgId])
  @@index([resourceId])
}

enum HazardLevel {
  NONE
  GHS01
  GHS02
  GHS03
  GHS04
  GHS05
  GHS06
  GHS07
  GHS08
  GHS09
}

model Reagent {
  id                String      @id @default(ulid())
  nodeId            String?
  orgId             String
  position          String
  name              String
  description       String?
  reagentTypeId     String?
  placedAt          DateTime?
  lastTakenAt       DateTime?
  environment       Json?
  responsibleUserId String?
  // P0 新增字段
  quantity          Float?
  unit              String?
  expiryDate        DateTime?
  manufactureDate   DateTime?
  batchNo           String?
  catalogNo         String?
  manufacturer      String?
  casNumber         String?
  storageCondition  Json?
  hazardLevel       HazardLevel?
  minStockThreshold Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  ownerOrg    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  node        Node?        @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  reagentType ReagentType? @relation(fields: [reagentTypeId], references: [id], onDelete: SetNull)
  reagentLogs ReagentLog[]

  @@index([nodeId])
  @@index([orgId])
  @@index([reagentTypeId])
  @@index([expiryDate])
}

model ReagentLog {
  id            String               @id @default(ulid())
  reagentId     String
  userId        String
  operationType ReagentOperationType
  detail        String?
  createdAt     DateTime             @default(now())

  reagent Reagent @relation(fields: [reagentId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([reagentId])
  @@index([userId])
}

enum ReagentOperationType {
  PLACED
  TAKEN
  MOVED
  UPDATED
  DELETED
}

model ReagentType {
  id          String   @id @default(ulid())
  orgId       String
  reagentId   String[]
  name        String
  description String?
  colorHex    String?
  unit        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  reagents Reagent[]

  @@index([orgId])
}

model EmailVerification {
  id        String   @id @default(ulid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model Feedback {
  id        String   @id @default(ulid())
  userId    String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model File {
  id          String         @id @default(uuid(7))
  userId      String
  domain      FileDomain
  visibility  FileVisibility
  bucket      String
  key         String
  filename    String
  contentType String
  status      FileStatus     @default(PENDING)
  createdAt   DateTime       @default(now())

  user          User          @relation(fields: [userId], references: [id])
  profileAvatar UserProfile[]

  @@index([userId])
  @@index([status, createdAt])
}

enum FileStatus {
  PENDING
  ACTIVE
  DELETED
}

enum FileDomain {
  AVATAR
  DOCUMENT
  VIDEO
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}
