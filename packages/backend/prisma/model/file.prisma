/// Storage metadata, not a public URL. Verification makes a pending object available.
model FileObject {
  id              String           @id @default(uuid(7)) @db.Uuid
  organizationId  String           @db.Uuid
  bucket          String
  key             String
  sizeBytes       BigInt
  contentType     String
  sha256          String?          @db.VarChar(64)
  status          FileObjectStatus @default(PENDING)
  uploadExpiresAt DateTime?        @db.Timestamptz(3)
  verifiedAt      DateTime?        @db.Timestamptz(3)
  deletedAt       DateTime?        @db.Timestamptz(3)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assets       FileAsset[]

  @@unique([organizationId, id])
  @@unique([bucket, key])
  @@index([organizationId, status, createdAt])
}

model FileAsset {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  objectId       String    @db.Uuid
  uploadedById   String    @db.Uuid
  filename       String
  deletedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  object       FileObject      @relation(fields: [organizationId, objectId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy   User            @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  references   FileReference[]

  @@unique([organizationId, id])
  @@index([organizationId, objectId])
  @@index([uploadedById])
}

/// Purpose keys are supplied by the owning module, not an IMAGE/DOCUMENT/VIDEO enum.
model FileReference {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @db.Uuid
  assetId        String    @db.Uuid
  resourceId     String    @db.Uuid
  purposeKey     String
  sortOrder      Int       @default(0)
  removedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)

  asset    FileAsset        @relation(fields: [organizationId, assetId], references: [organizationId, id], onDelete: Restrict)
  resource ResourceIdentity @relation(fields: [organizationId, resourceId], references: [organizationId, id], onDelete: Restrict)

  @@unique([assetId, resourceId, purposeKey])
  @@index([organizationId, resourceId, purposeKey, removedAt, sortOrder])
}

enum FileObjectStatus {
  PENDING
  AVAILABLE
  DELETED
}
