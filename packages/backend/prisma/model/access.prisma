model Session {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @db.Uuid
  version       Int       @default(1)
  idleExpiresAt DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenPairs TokenPair[]

  @@index([userId])
  @@index([idleExpiresAt])
  @@index([createdAt])
  @@index([updatedAt])
}

model TokenPair {
  id         String    @id @default(uuid(7)) @db.Uuid
  sessionId  String    @db.Uuid
  generation Int       @default(1)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  session      Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  accessToken  AccessToken?
  refreshToken RefreshToken?

  @@unique([sessionId, generation])
}

model AccessToken {
  id        String   @id @default(uuid(7)) @db.Uuid // JWT jti
  pairId    String   @unique @db.Uuid
  expiresAt DateTime
  createdAt DateTime

  tokenPair TokenPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  pairId     String    @unique @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime

  tokenPair TokenPair @relation(fields: [pairId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
