NODE_ENV=development
PORT=3000
DATABASE_URL=
SHADOW_DATABASE_URL=

ALLOWED_ORIGINS_PROD=
ALLOWED_ORIGINS_DEV=http://localhost:5173

LOG_LEVEL=

SLOW_REQUEST_WARN_MS=1000
SLOW_REQUEST_ERROR_MS=3000

SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500

REQUEST_TIMEOUT_MS=30000

API_DOCS_BASE_URL=http://localhost:3000/errors

# JWT
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_PRIVATE_KEY=
JWT_REFRESH_PUBLIC_KEY=
JWT_REFRESH_EXPIRES_IN=7d

JWT_REFRESH_COOKIE_SAME_SITE=lax
JWT_REFRESH_COOKIE_SECURE=false
JWT_REFRESH_COOKIE_PATH=/auth
JWT_REFRESH_COOKIE_MAX_AGE_MS=604800000

# Casdoor（启用 CasdoorModule 时，以下字段必须同时配置）
CASDOOR_ENDPOINT=
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=
CASDOOR_APPLICATION=
# 例如：secrets/crypto/casdoor/token_jwt_key.pem
CASDOOR_CERTIFICATE_PATH=
# 必须与 Casdoor 应用中登记的回调地址完全一致；留空则禁用平台级 OIDC 登录。
CASDOOR_OIDC_REDIRECT_URI=
# 反向代理使 JWT 的 iss 与 CASDOOR_ENDPOINT 不同时显式设置；通常留空即可。
CASDOOR_OIDC_ISSUER=

S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
