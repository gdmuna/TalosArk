# Complete backend runtime template. Values are examples, not deployment credentials.
# See README.md for defaults, required fields and profile/local precedence.
# local files are sparse overrides; an explicit empty local value still overrides base.

# Application. Optional metadata defaults to package.json; GIT_COMMIT defaults to N/A.
NODE_ENV=development
PORT=3000
APP_NAME=talos-ark
APP_VERSION=0.1.0
APP_AUTHOR=Maiturin
GIT_COMMIT=example-commit

# Database/KVS. REQUIRED at startup; replace the example connection URLs.
DATABASE_URL=postgresql://talosark:change-me@localhost:5432/talosark?schema=public
SHADOW_DATABASE_URL=postgresql://talosark:change-me@localhost:5432/talosark_shadow?schema=public
KVS_URL=redis://localhost:6379
KVS_CONNECT_TIMEOUT_MS=3000
KVS_CLOSE_TIMEOUT_MS=2000

# HTTP. Origin modes: deny, allowlist, development-loopback, development-any.
# allowlist requires nonempty origins; development-* requires NODE_ENV=development.
# Production allowlists require HTTPS. CORS_ENABLED does not disable Auth checks.
CORS_ENABLED=true
HTTP_BROWSER_ORIGIN_MODE=development-loopback
HTTP_BROWSER_ALLOWED_ORIGINS=http://localhost:4444
THROTTLE_TTL_MS=300000
THROTTLE_LIMIT=1000
REQUEST_TIMEOUT_MS=30000
REQUEST_ID_HEADER=x-request-id
CORS_PREFLIGHT_MAX_AGE_SECONDS=86400
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-TalosArk-Client

# Authentication. REQUIRED key pair: ES256 / P-256 PEM, with newlines or escaped \n.
# TODO(required): generate a real private key; example shape: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----".
JWT_ACCESS_PRIVATE_KEY=
# TODO(required): matching public key; example shape: "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----".
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m
IDENTITY_PASSWORD_HASH_CONCURRENCY=2
# Production requires true and an HTTPS activation URL for the actual frontend.
AUTH_COOKIE_SECURE=false
AUTH_ACTIVATION_URL=http://localhost:4444/auth/activate
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_RECOVERY_URL=http://localhost:4444/auth/reset-password
AUTH_RECOVERY_TTL_SECONDS=1800
AUTH_RECOVERY_COOLDOWN_SECONDS=60
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_EMAIL_LIMIT=5
AUTH_RECOVERY_IP_LIMIT=20
AUTH_FIRST_PASSWORD_SESSION_MAX_AGE_SECONDS=600
AUTH_ATTEMPT_WINDOW_SECONDS=300
AUTH_ACCOUNT_ATTEMPT_LIMIT=5
AUTH_IP_ATTEMPT_LIMIT=30

# Casdoor is REQUIRED by the current application, not disabled by empty values.
# Replace provider-specific examples and deploy its real token-verification certificate.
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=talos-ark-example-client
# TODO(required): provider-issued secret; example: replace-with-casdoor-client-secret.
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=talos-ark
CASDOOR_APPLICATION=talos-ark
CASDOOR_CERTIFICATE_PATH=secrets/crypto/casdoor/token_jwt_key.pem
CASDOOR_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/login-callback
# Optional: defaults to CASDOOR_ENDPOINT; set only when the token issuer differs.
CASDOOR_OIDC_ISSUER=http://localhost:8000

# Storage. Endpoint and both credentials are REQUIRED by current configuration validation.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# TODO(required): provision real credentials; example ID: talosark-example-access-key.
S3_ACCESS_KEY_ID=
# TODO(required): example secret shape: replace-with-storage-secret-key.
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=app-public
S3_BUCKET_PRIVATE=app-private
S3_BUCKET_STAGING=app-staging
S3_FORCE_PATH_STYLE=true
# Optional public object URL prefix; empty means no separately configured prefix.
S3_PUBLIC_BASE_URL=http://localhost:9000/app-public

# Mail is required only when a business module imports MailModule; it is not active yet.
# Replace host/from examples before activation; verify does not send an email.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# Optional: inferred from port (true for 465, false otherwise). 587 uses STARTTLS.
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
# Optional TLS hostname override; normally omit/leave empty to use SMTP_HOST.
SMTP_SERVERNAME=smtp.example.com
# Conditional: configure user/pass together for authentication; omit both only for a trusted relay.
SMTP_USER=mailer@example.com
# TODO(required-if-smtp-auth): provider/app password; example: replace-with-smtp-app-password.
SMTP_PASS=
SMTP_FROM="TalosArk <no-reply@example.com>"
# Optional timeouts: milliseconds, integer range 1..120000. Values below are defaults.
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_DNS_TIMEOUT_MS=5000
# Whole operation deadline, including connection/TLS/auth/DATA; not just send duration.
SMTP_SEND_TIMEOUT_MS=30000
SMTP_CLOSE_TIMEOUT_MS=2000
# Optional range 1..20; counts verify/send operations, excess calls fail busy without queueing.
SMTP_MAX_CONCURRENT_SENDS=3

# Observability. Optional; set production documentation URLs to the actual deployment.
LOG_LEVEL=info
SLOW_REQUEST_WARN_MS=1000
SLOW_REQUEST_ERROR_MS=3000
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500
API_DOCS_BASE_URL=http://localhost:3000/errors
ERROR_REFERENCE_URL=http://localhost:5173/04-appendix/error-reference

# Shutdown. HTTP_DRAIN_TIMEOUT_MS + LOG_FLUSH_TIMEOUT_MS must be < SHUTDOWN_TIMEOUT_MS.
SHUTDOWN_TIMEOUT_MS=10000
HTTP_DRAIN_TIMEOUT_MS=5000
LOG_FLUSH_TIMEOUT_MS=500

# Tool-only: OpenAPI exporter; it does not load this file automatically.
BACKEND_URL=http://localhost:3000
