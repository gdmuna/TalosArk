# Backend runtime example; values are examples, not deployment credentials.
# See README.md for defaults, required inputs and profile/local precedence.
# Local overrides apply only when explicitly loaded; empty local values override the base.
# REQUIRED / DEPLOYMENT notes describe requirements, not effective configuration status.

# --- Application ---
# Optional metadata defaults to package.json / N/A when empty.
NODE_ENV=development
PORT=3000
APP_NAME=talos-ark
APP_VERSION=0.1.0
APP_AUTHOR=Maiturin
GIT_COMMIT=example-commit

# --- HTTP and browser access ---
# Browser origin policy, CORS, throttling and request deadlines.
# development-* origin modes are only valid for NODE_ENV=development.
# allowlist requires nonempty origins.
# Production allowlists require HTTPS. CORS_ENABLED does not disable Auth checks.
CORS_ENABLED=true
HTTP_BROWSER_ORIGIN_MODE=development-loopback
HTTP_BROWSER_ALLOWED_ORIGINS=http://localhost:4444
THROTTLE_TTL_MS=300000
THROTTLE_LIMIT=1000
REQUEST_TIMEOUT_MS=30000
REQUEST_ID_HEADER=x-request-id
CORS_PREFLIGHT_MAX_AGE_SECONDS=86400
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-TalosArk-Client

# --- Access token ---
# REQUIRED: a real matching ES256 / P-256 PEM key pair; preserve multiline values.
# REQUIRED: generate a real private key; example shape: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----".
JWT_ACCESS_PRIVATE_KEY=
# REQUIRED: matching public key; example shape: "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----".
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_EXPIRES_IN=15m

# --- Identity ---
# Bounded concurrency for password hashing.
IDENTITY_PASSWORD_HASH_CONCURRENCY=2

# --- Authentication and account lifecycle ---
# Production cookies and frontend account URLs must use HTTPS.
# Production requires AUTH_COOKIE_SECURE=true.
AUTH_COOKIE_SECURE=false
AUTH_ACTIVATION_URL=http://localhost:4444/auth/activate
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_RECOVERY_URL=http://localhost:4444/auth/reset-password
AUTH_RECOVERY_TTL_SECONDS=1800
AUTH_RECOVERY_COOLDOWN_SECONDS=60
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_EMAIL_LIMIT=5
AUTH_RECOVERY_IP_LIMIT=20
AUTH_FIRST_PASSWORD_SESSION_MAX_AGE_SECONDS=600
AUTH_ATTEMPT_WINDOW_SECONDS=300
AUTH_ACCOUNT_ATTEMPT_LIMIT=5
AUTH_IP_ATTEMPT_LIMIT=30

# --- Identity provider (Casdoor) ---
# REQUIRED for the current application; local or process overrides may supply these.
# Replace provider-specific examples and deploy its real token-verification certificate.
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=talos-ark-example-client
# REQUIRED: provider-issued secret; example: replace-with-casdoor-client-secret.
CASDOOR_CLIENT_SECRET=
CASDOOR_ORGANIZATION=talos-ark
CASDOOR_APPLICATION=talos-ark
CASDOOR_CERTIFICATE_PATH=secrets/crypto/casdoor/token_jwt_key.pem
CASDOOR_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/oidc/login-callback
# Optional: defaults to CASDOOR_ENDPOINT; set only when the token issuer differs.
CASDOOR_OIDC_ISSUER=http://localhost:8000

# --- Database ---
# REQUIRED: independent primary and shadow database URLs.
DATABASE_URL=postgresql://talosark:change-me@localhost:5432/talosark?schema=public
SHADOW_DATABASE_URL=postgresql://talosark:change-me@localhost:5432/talosark_shadow?schema=public

# --- KVS ---
# Connection URL and lifecycle deadlines; timeouts are milliseconds.
KVS_URL=redis://localhost:6379
KVS_CONNECT_TIMEOUT_MS=3000
KVS_CLOSE_TIMEOUT_MS=2000

# --- Background tasks (I09) ---
# Opt in after synchronizing BackgroundJob. Empty URL reuses KVS_URL.
TASK_ENABLED=false
TASK_WORKER_ENABLED=true
TASK_REDIS_URL=
TASK_QUEUE_PREFIX=talosark
TASK_CONCURRENCY=2
TASK_POLL_INTERVAL_MS=5000
TASK_BATCH_SIZE=20
TASK_REDIS_TIMEOUT_MS=3000
TASK_CLOSE_TIMEOUT_MS=3000
TASK_RETENTION_DAYS=30

# --- Object storage ---
# REQUIRED: actual endpoint and credentials; bucket names are deployment-specific.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# REQUIRED: provision real credentials; example ID: talosark-example-access-key.
S3_ACCESS_KEY_ID=
# REQUIRED: example secret shape: replace-with-storage-secret-key.
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=app-public
S3_BUCKET_PRIVATE=app-private
S3_BUCKET_STAGING=app-staging
S3_FORCE_PATH_STYLE=true
# Optional public object URL prefix; empty means no separately configured prefix.
S3_PUBLIC_BASE_URL=http://localhost:9000

# --- Mail (SMTP) ---
# Active in Web startup: verify connects/authenticates without sending mail.
# Timeouts are milliseconds, range 1..120000. SEND is the total verify/send deadline.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# Optional: inferred from port (true for 465, false otherwise). 587 uses STARTTLS.
SMTP_SECURE=true
SMTP_REQUIRE_TLS=true
# Optional TLS hostname override; normally omit/leave empty to use SMTP_HOST.
SMTP_SERVERNAME=smtp.example.com
# Conditional: configure user/pass together for authentication; omit both only for a trusted relay.
SMTP_USER=mailer@example.com
# REQUIRED WHEN AUTHENTICATING: provider/app password; example: replace-with-smtp-app-password.
SMTP_PASS=
SMTP_FROM="TalosArk <no-reply@example.com>"
# The following timeout values are defaults.
SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
SMTP_DNS_TIMEOUT_MS=5000
# Whole operation deadline, including connection/TLS/auth/DATA; not just send duration.
SMTP_SEND_TIMEOUT_MS=30000
SMTP_CLOSE_TIMEOUT_MS=2000
# Optional range 1..20; counts verify/send operations, excess calls fail busy without queueing.
SMTP_MAX_CONCURRENT_SENDS=3

# --- Observability ---
# Output is independent of NODE_ENV; empty preserves dev=console, test/prod=file.
LOG_OUTPUT=
# Empty format preserves dev=pretty, test/prod=json. Files always contain JSON.
LOG_CONSOLE_FORMAT=
LOG_CONSOLE_COLOR=auto
# Empty per-output levels inherit LOG_LEVEL; LOG_LEVEL remains the global minimum.
LOG_CONSOLE_LEVEL=
LOG_FILE_LEVEL=
# Use a distinct path per process/replica when writing files.
LOG_FILE_PATH=./data/logs/app.log
LOG_FILE_ROTATION=none
# 0 disables size rotation. Retain count is archived files, plus the active file.
LOG_FILE_MAX_SIZE_MB=0
LOG_FILE_RETAIN_COUNT=14
# Keep probability for trace/debug/info only; warn/error/fatal are never sampled.
LOG_SAMPLE_RATE=1
LOG_WORKER_START_TIMEOUT_MS=5000
# Log levels, slow-operation thresholds and documentation URLs.
API_DOCS_BASE_URL=http://localhost:3000/errors
ERROR_REFERENCE_URL=http://localhost:5173/04-appendix/error-reference
LOG_LEVEL=info
SLOW_REQUEST_WARN_MS=1000
SLOW_REQUEST_ERROR_MS=3000
SLOW_QUERY_WARN_MS=100
SLOW_QUERY_ERROR_MS=500

# --- Telemetry (OTel metrics and tracing) ---
# Opt in explicitly. The endpoint is a collector base URL, not /v1/traces.
OTEL_SDK_DISABLED=true
# Empty inherits APP_NAME. Resource metadata never comes from request input.
OTEL_SERVICE_NAME=
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
# Required when enabled; /v1/traces and /v1/metrics are appended.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional secret: comma-separated name=percent-encoded-value entries.
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_METRIC_EXPORT_INTERVAL=15000
# Parent-based trace sampling; metrics are independent and unsampled.
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=256

# --- Process lifecycle ---
TELEMETRY_FLUSH_TIMEOUT_MS=1000
# Milliseconds: HTTP_DRAIN + LOG_FLUSH + TELEMETRY_FLUSH must be below SHUTDOWN_TIMEOUT_MS.
SHUTDOWN_TIMEOUT_MS=10000
HTTP_DRAIN_TIMEOUT_MS=5000
LOG_FLUSH_TIMEOUT_MS=500

# --- Tooling ---
# OpenAPI exporter only; BACKEND_URL defaults to http://localhost:<PORT or 3000>.
BACKEND_URL=http://localhost:3000
TEAM_INVITATION_URL=http://localhost:4444/auth/invitation
TEAM_INVITATION_TTL_SECONDS=604800
# Inventory calendar: IANA time zone used for date-only expiry decisions.
INVENTORY_BUSINESS_TIME_ZONE=Asia/Shanghai
