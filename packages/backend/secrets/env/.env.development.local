# Sparse overrides for .env.development.
# See README.md for defaults, required inputs and profile/local precedence.
# Omit keys to inherit. KEY= explicitly overrides the base with an empty value.
# REQUIRED / DEPLOYMENT notes describe requirements, not effective configuration status.

# --- HTTP and browser access ---
# Browser origin policy, CORS, throttling and request deadlines.
# development-* origin modes are only valid for NODE_ENV=development.
CORS_ENABLED=true
HTTP_BROWSER_ORIGIN_MODE=development-loopback
HTTP_BROWSER_ALLOWED_ORIGINS=

# --- Identity ---
# Bounded concurrency for password hashing.
IDENTITY_PASSWORD_HASH_CONCURRENCY=2

# --- Authentication and account lifecycle ---
# Production cookies and frontend account URLs must use HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ACTIVATION_URL=http://localhost:4444/auth/activate
AUTH_ACTIVATION_TTL_SECONDS=86400
AUTH_RECOVERY_URL=http://localhost:4444/auth/reset-password
AUTH_RECOVERY_TTL_SECONDS=1800
AUTH_RECOVERY_COOLDOWN_SECONDS=60
AUTH_RECOVERY_WINDOW_SECONDS=3600
AUTH_RECOVERY_EMAIL_LIMIT=5
AUTH_RECOVERY_IP_LIMIT=20
AUTH_FIRST_PASSWORD_SESSION_MAX_AGE_SECONDS=600
AUTH_ATTEMPT_WINDOW_SECONDS=300
AUTH_ACCOUNT_ATTEMPT_LIMIT=5
AUTH_IP_ATTEMPT_LIMIT=30

# --- Identity provider (Casdoor) ---
# REQUIRED for the current application; local or process overrides may supply these.
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=5c31453ff73fbe8b4369
CASDOOR_CLIENT_SECRET=e103b7302f51cf6fa984caf42bf114655fcb9a9f
CASDOOR_ORGANIZATION=built-in
CASDOOR_APPLICATION=
CASDOOR_CERTIFICATE_PATH=secrets/crypto/casdoor/token_jwt_key_local.pem
CASDOOR_OIDC_REDIRECT_URI=http://localhost:4444/auth/callback

# --- Database ---
# REQUIRED: independent primary and shadow database URLs.
DATABASE_URL=postgresql://admin:admin@localhost:5432/talos-ark_backend_dev?schema=public
SHADOW_DATABASE_URL=postgresql://admin:admin@localhost:5432/talos-ark_backend_shadow_dev?schema=public

# --- KVS ---
# Connection URL and lifecycle deadlines; timeouts are milliseconds.
KVS_URL=valkey://@localhost:6379
KVS_CONNECT_TIMEOUT_MS=3000
KVS_CLOSE_TIMEOUT_MS=2000

# --- Object storage ---
# REQUIRED: actual endpoint and credentials; bucket names are deployment-specific.
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY_ID=admin_id
S3_SECRET_ACCESS_KEY=admin_secret
S3_PUBLIC_BASE_URL=localhost:9001

# --- Process lifecycle ---
# Milliseconds: HTTP_DRAIN_TIMEOUT_MS + LOG_FLUSH_TIMEOUT_MS < SHUTDOWN_TIMEOUT_MS.
SHUTDOWN_TIMEOUT_MS=10000
HTTP_DRAIN_TIMEOUT_MS=5000
LOG_FLUSH_TIMEOUT_MS=500
TEAM_INVITATION_URL=http://localhost:4444/auth/invitation
TEAM_INVITATION_TTL_SECONDS=604800
