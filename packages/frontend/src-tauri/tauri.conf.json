{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalosArk",
  "version": "0.1.0",
  "identifier": "com.gdmuna.apps.talos-ark",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:4444",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TalosArk",
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true,
        "alwaysOnTop": false,
        "maximized": true,
        "visible": true,
        "center": true,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
