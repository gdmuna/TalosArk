#!/bin/sh

GREEN="\033[32m"; YELLOW="\033[33m"; RESET="\033[0m"

log()  { printf "%-12b %b\n" "${GREEN}[GitHook]" "[LOG] $1${RESET}"; }
warn() { printf "%-12b %b\n" "${YELLOW}[GitHook]" "[WARN] $1${RESET}"; }

log "执行 Pre-commit hook"

ENV_PATH_PREFIX='packages/backend/secrets'

# 加密 backend env 文件
backend_envs=$(git diff --cached --name-only -- \
    ":(glob)$ENV_PATH_PREFIX/**/.env.*" \
    ":(exclude,glob)$ENV_PATH_PREFIX/**/.env.example" \
    ":(exclude,glob)$ENV_PATH_PREFIX/**/.env.*.local" \
    | sed 's|^packages/backend/||' || true)

if [ -n "$backend_envs" ]; then
    log "加密 backend env 文件"
    backend_args=""
    for f in $backend_envs; do backend_args="$backend_args -f $f"; done
    pnpm --filter @talos-ark/backend dotenvx encrypt $backend_args
    git add $(echo "$backend_envs" | sed 's|^|packages/backend/|')
fi

if git diff --cached --quiet; then
    warn "无暂存文件，跳出 Pre-commit hooks"
    exit 0
fi

log "执行 lint-staged"

pnpm lint-staged

log "执行 lint-staged 完毕"

log "Pre-commit hooks 执行完毕"
exit 0
